# URL base de la API del backend (incluye el prefijo /api). Es publica: se incrusta en el bundle del navegador.
# El navegador llama directamente a la API (no hay proxy de Next.js, ver ADR-07). Abra la aplicacion en
# http://localhost:3000: el backend solo admite ese origen (CORS_ORIGIN).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
