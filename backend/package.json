{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API y worker (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "bench:search": "tsx src/scripts/bench-search.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "docs:purge-errors": "tsx src/scripts/purge-errors.ts",
    "fixtures:generate": "tsx test/fixtures/generate.ts",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node scripts/run-integration.js",
    "test:cov": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --selectProjects unit --coverage"
  },
  "dependencies": {
    "@kata/shared": "*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
