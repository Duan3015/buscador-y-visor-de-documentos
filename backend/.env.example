# Copie este archivo a backend/.env. Los valores de ejemplo son solo para desarrollo local.

# Rol del proceso: api, worker o all (API y worker en un solo proceso)
APP_ROLE=all
PORT=3001

# PostgreSQL del docker-compose (puerto 5433 en el host)
DATABASE_URL=postgres://docs:docs@localhost:5433/docs

# Carpeta de los archivos originales
STORAGE_DIR=./storage

# Unico origen permitido por CORS. Abra la aplicacion en http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Limites de carga y extraccion (ADR-03)
MAX_UPLOAD_BYTES_TEXT=3145728
MAX_UPLOAD_BYTES_PDF=20971520
MAX_PDF_PAGES=1000
MAX_EXTRACTED_CHARS=3000000
MAX_INDEXABLE_CHARS=300000
# Caracteres iniciales de cada documento sobre los que se resaltan los fragmentos (ADR-03).
# Acota el costo de la busqueda con terminos frecuentes; no puede superar MAX_INDEXABLE_CHARS.
MAX_HIGHLIGHT_CHARS=100000
EXTRACTION_TIMEOUT_MS=60000

# Procesamiento asincrono (ADR-04, ADR-08)
WORKER_CONCURRENCY=2
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY_SECONDS=10

# Tiempo real (ADR-07)
MAX_SSE_CLIENTS=500
